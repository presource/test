{
    "name": "@presource/test",
    "version": "1.0.0",
    "description": "Storybook testing and verification utilities for the presource ecosystem",
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "types": "src/index.ts",
    "files": [
        "src"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "release": "vite-node ../../../scripts/publish-safe.ts"
    },
    "dependencies": {
        "@presource/core": "*",
        "@presource/web": "*",
        "@storybook/react": "^10.0.0",
        "@storybook/react-dom-shim": "^10.0.0",
        "@testing-library/react": "^16.3.2",
        "storybook": "^10.0.0"
    },
    "peerDependencies": {
        "react": "^18.2.0"
    },
    "author": "NQQT",
    "license": "ISC"
}
